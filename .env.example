# Copiar a .env.local y completar con los valores de `supabase status`
# (desarrollo local) o del panel del proyecto en supabase.com (cloud).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de servidor (tests de integración, seeds). Nunca con
# prefijo NEXT_PUBLIC_: esta clave evita RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Clave secreta de Liveblocks (coedición en vivo), panel de proyecto en
# liveblocks.io. Solo para el endpoint de autenticación en el servidor,
# nunca con prefijo NEXT_PUBLIC_.
LIVEBLOCKS_SECRET_KEY=
