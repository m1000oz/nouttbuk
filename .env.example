# Copiar a .env.local y completar con los valores de `supabase status`
# (desarrollo local) o del panel del proyecto en supabase.com (cloud).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de servidor (tests de integración, seeds). Nunca con
# prefijo NEXT_PUBLIC_: esta clave evita RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Clave secreta de Liveblocks (coedición en vivo), panel de proyecto en
# liveblocks.io. Solo para el endpoint de autenticación en el servidor,
# nunca con prefijo NEXT_PUBLIC_.
LIVEBLOCKS_SECRET_KEY=

# "Continuar con Google" (supabase/config.toml → [auth.external.google]).
# OAuth Client ID de tipo "Web application" en Google Cloud Console.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# CAPTCHA en signup/login/recuperar contraseña (supabase/config.toml →
# [auth.captcha]). Sitio "Managed" en el dashboard de Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SUPABASE_AUTH_CAPTCHA_SECRET=
